# Supabase project (separate from demo #1): Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_...). Server only - never ship it to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase: Connect -> Session pooler connection string (used only by migrate, seed and reset)
SUPABASE_DB_URL=

# Demo mode: shows the one-click sign-in buttons
NEXT_PUBLIC_DEMO_MODE=true
DEMO_PASSWORD=demo1234
